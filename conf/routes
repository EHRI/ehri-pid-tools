# Routes file

GET           /                                      controllers.HomeController.index()
GET           /policy                                controllers.HomeController.policy()
GET           /health                                controllers.HealthController.index()

# DOI operations
GET           /dois                                  controllers.DoiController.index(params: models.ListParams ?= models.ListParams.empty)
GET           /dois/:prefix/*suffix                  controllers.DoiController.get(prefix: String, suffix: String)
GET           /dois/example                          controllers.DoiController.example()
GET           /dois/target-health                    controllers.DoiController.targetHealth()
GET           /dois/health                           controllers.DoiController.health()
+nocsrf
POST          /dois                                  controllers.DoiController.register()
+nocsrf
PUT           /dois/:prefix/*suffix                  controllers.DoiController.update(prefix: String, suffix: String)
+nocsrf
DELETE        /dois/:prefix/*suffix                  controllers.DoiController.delete(prefix: String, suffix: String)
+nocsrf
POST          /dois/:prefix/*suffix/tombstone        controllers.DoiController.tombstone(prefix: String, suffix: String)
+nocsrf
DELETE        /dois/:prefix/*suffix/tombstone        controllers.DoiController.deleteTombstone(prefix: String, suffix: String)

# Preview
GET           /preview                               controllers.PreviewController.preview(url: String ?= "")

# Map static resources from the /public folder to the /assets URL path
GET           /assets/*file                          controllers.Assets.versioned(path="/public", file: Asset)

# robots.txt needs to be served from the root, unversioned
GET           /robots.txt                             controllers.Assets.at(path="/public", file="robots.txt")
